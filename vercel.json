{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/health", "destination": "/api/health" },
    { "source": "/px", "destination": "/api/public/px" },
    { "source": "/api/px", "destination": "/api/public/px" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
